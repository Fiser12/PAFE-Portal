# Copiar a .docker.env (no versionar) y completar los secretos.
# Usar siempre docker compose --env-file .docker.env ...
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAFE_PORT=3000
PAFE_BIND_ADDRESS=127.0.0.1

# Generar cada secreto por separado: openssl rand -hex 32
PAYLOAD_SECRET=
AUTH_SECRET=
CRON_SECRET=
PREVIEW_SECRET=

# PostgreSQL local (--profile local-db). Contraseña hex evita escapar la URL.
POSTGRES_USER=pafe_user
POSTGRES_DB=db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Para Neon/PostgreSQL externo, sustituir DATABASE_URL y omitir local-db.

# Storage S3 compatible: bucket existente, privado, con credenciales limitadas.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional: dominio público de portadas; también se utiliza durante el build.
S3_PUBLIC_URL=

# Google OAuth: autorizar <NEXT_PUBLIC_SERVER_URL>/api/auth/callback/google
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
ENABLED_SUPER_ADMIN=false
SUPER_ADMIN_EMAIL=

# Sin Resend los correos solo se escriben en consola: completar para producción.
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=PAFE

# Compose impone estas protecciones incluso si se cambia este fichero.
PAYLOAD_DISABLE_PUSH=true
PAYLOAD_RUN_MIGRATIONS=false
SEED_MOCK_DATA=false
# Proceso persistente: autoRun ejecuta recordatorios y noticias programadas.
DISABLE_JOBS_AUTORUN=false
